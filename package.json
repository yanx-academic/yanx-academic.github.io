{
  "name": "yanx-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist/ssr && node scripts/prerender.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/content.test.mjs tests/prepare.test.mjs",
    "predev": "node scripts/prepare-content.mjs",
    "prebuild": "node scripts/prepare-content.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "markdown-it": "14.1.0",
    "gray-matter": "4.0.3",
    "@phosphor-icons/react": "2.1.10"
  },
  "devDependencies": {}
}
